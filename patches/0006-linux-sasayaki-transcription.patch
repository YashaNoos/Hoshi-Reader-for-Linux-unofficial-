@@ -0,0 +1,280 @@
+// Port of swift/SasayakiAligner.swift (macOS) so Linux aligns transcripts the same way.
+// Copyright © 2026 Manhhao. SPDX-License-Identifier: GPL-3.0-or-later
+
+use std::sync::LazyLock;
+
+use regex::Regex;
+use similar::{Algorithm, DiffOp, capture_diff_slices};
+use unicode_normalization::UnicodeNormalization;
+
+use super::Token;
+use crate::library;
+use crate::sasayaki::{Chapter, SasayakiMatch, SasayakiMatchData, Source};
+
+#[derive(Clone, Copy)]
+struct Timing {
+    start: f64,
+    end: f64,
+}
+
+struct Speech {
+    characters: Vec<char>,
+    timings: Vec<Timing>,
+}
+
+static RE_CHARACTER: LazyLock<Regex> =
+    LazyLock::new(|| Regex::new(&format!("[{}]", library::CHARACTER_CLASS)).unwrap());
+
+impl Speech {
+    fn new(tokens: &[Token]) -> Self {
+        let mut characters = Vec::new();
+        let mut timings = Vec::new();
+        for token in tokens {
+            for found in RE_CHARACTER.find_iter(&token.text) {
+                if let Some(character) = found.as_str().chars().next() {
+                    characters.push(normalize(character));
+                    timings.push(Timing { start: token.start, end: token.end });
+                }
+            }
+        }
+        Speech { characters, timings }
+    }
+}
+
+#[derive(Clone, Copy)]
+struct Anchor {
+    speech: usize,
+    book: usize,
+}
+
+struct Span {
+    from: f64,
+    to: f64,
+    lower: usize,
+    upper: usize,
+}
+
+const PROBE_LENGTH: usize = 12;
+const PROBE_STRIDE: usize = 100;
+const MAX_BLOCK: usize = 2000;
+const MAX_SECONDS_PER_CHARACTER: f64 = 0.7;
+const DURATION_OVERHEAD: f64 = 1.0;
+const MAX_EDGE: usize = 12;
+const MAX_INTERPOLATED: usize = 8;
+const MAX_INTERPOLATED_GAP: f64 = 2.5;
+const END_PADDING: f64 = 0.3;
+const LEADING_GAP: f64 = 0.5;
+const CHARACTER_SPAN: f64 = 0.15;
+const START_LEAD: f64 = 0.2;
+
+pub fn align(source: &Source, tokens: &[Token]) -> SasayakiMatchData {
+    let book: Vec<char> = source.text.iter().copied().map(normalize).collect();
+    let speech = Speech::new(tokens);
+    let mut times: Vec<Option<Timing>> = vec![None; book.len()];
+    let anchors = anchors(&speech, &book, &source.chapters);
+    for pair in anchors.windows(2) {
+        let (anchor, next) = (pair[0], pair[1]);
+        if next.speech <= anchor.speech || next.book <= anchor.book {
+            continue;
+        }
+        let bounded = Anchor {
+            speech: next.speech.min(anchor.speech + MAX_BLOCK),
+            book: next.book.min(anchor.book + MAX_BLOCK),
+        };
+        assign(&speech, &book, anchor, bounded, &mut times);
+    }
+    cut(source, &times)
+}
+
+fn normalize(character: char) -> char {
+    let mapped: String = character.to_string().nfkc().collect::<String>().to_lowercase();
+    let scalar = mapped.chars().next().unwrap_or(character);
+    if ('\u{30A1}'..='\u{30F6}').contains(&scalar) {
+        return char::from_u32(scalar as u32 - 0x60).unwrap_or(scalar);
+    }
+    scalar
+}
+
+fn find_text(source: &[char], text: &[char], start: usize, end: usize) -> Option<usize> {
+    let mut index = start;
+    while index + text.len() <= end {
+        if source[index..index + text.len()] == *text {
+            return Some(index);
+        }
+        index += 1;
+    }
+    None
+}
+
+fn anchors(speech: &Speech, book: &[char], chapters: &[Chapter]) -> Vec<Anchor> {
+    let mut anchors = vec![Anchor { speech: 0, book: 0 }];
+    if let Some(chapter) = chapters.iter().find(|chapter| chapter.length >= PROBE_LENGTH) {
+        let probe = &book[chapter.start..chapter.start + PROBE_LENGTH];
+        if let Some(found) = find_text(&speech.characters, probe, 0, speech.characters.len()) {
+            anchors[0] = Anchor { speech: found, book: chapter.start };
+        }
+    }
+
+    let mut cursor = 0;
+    if speech.characters.len() >= PROBE_LENGTH {
+        let mut index = 0;
+        while index <= speech.characters.len() - PROBE_LENGTH {
+            let probe = &speech.characters[index..index + PROBE_LENGTH];
+            let limit = book.len().min(cursor + MAX_BLOCK + PROBE_LENGTH);
+            if let Some(found) = find_text(book, probe, cursor, limit) {
+                cursor = found + PROBE_LENGTH;
+                let previous = *anchors.last().unwrap();
+                if index > previous.speech && found > previous.book {
+                    anchors.push(Anchor { speech: index, book: found });
+                }
+            }
+            index += PROBE_STRIDE;
+        }
+    }
+    anchors.push(Anchor { speech: speech.characters.len(), book: book.len() });
+    anchors
+}
+
+fn assign(speech: &Speech, book: &[char], anchor: Anchor, next: Anchor, times: &mut [Option<Timing>]) {
+    let spoken = &speech.characters[anchor.speech..next.speech];
+    let written = &book[anchor.book..next.book];
+    // Same shape as Swift's `written.difference(from: spoken)`: removals index the
+    // spoken text, insertions index the written text (both Myers diffs).
+    let mut removed = vec![false; spoken.len()];
+    let mut inserted = vec![false; written.len()];
+    for op in capture_diff_slices(Algorithm::Myers, spoken, written) {
+        match op {
+            DiffOp::Equal { .. } => {}
+            DiffOp::Delete { old_index, old_len, .. } => {
+                removed[old_index..old_index + old_len].fill(true);
+            }
+            DiffOp::Insert { new_index, new_len, .. } => {
+                inserted[new_index..new_index + new_len].fill(true);
+            }
+            DiffOp::Replace { old_index, old_len, new_index, new_len } => {
+                removed[old_index..old_index + old_len].fill(true);
+                inserted[new_index..new_index + new_len].fill(true);
+            }
+        }
+    }
+
+    let mut offset = 0;
+    for index in 0..removed.len() {
+        if !removed[index] {
+            while offset < inserted.len() && inserted[offset] {
+                offset += 1;
+            }
+        }
+        let target = anchor.book + offset.min(written.len() - 1);
+        if times[target].is_none() {
+            times[target] = Some(speech.timings[anchor.speech + index]);
+        }
+        let substitution = offset < inserted.len() && inserted[offset];
+        if !removed[index] || substitution {
+            offset += 1;
+        }
+    }
+}
+
+fn cut(source: &Source, times: &[Option<Timing>]) -> SasayakiMatchData {
+    let mut matches: Vec<SasayakiMatch> = Vec::new();
+    let mut unmatched = 0;
+    for chapter in &source.chapters {
+        let mut start = chapter.start;
+        for index in chapter.start..chapter.end() {
+            if !is_boundary(source, chapter, start, index) {
+                continue;
+            }
+            match time(start, index, chapter, times, matches.last()) {
+                Some(span) => matches.push(SasayakiMatch {
+                    id: format!("{}-{}", chapter.chapter_index, span.lower - chapter.start),
+                    start_time: span.from,
+                    end_time: span.to,
+                    text: source.text[span.lower..=span.upper].iter().collect(),
+                    chapter_index: chapter.chapter_index,
+                    start: span.lower - chapter.start,
+                    length: span.upper - span.lower + 1,
+                }),
+                None => unmatched += 1,
+            }
+            start = index + 1;
+        }
+    }
+
+    matches.sort_by(|a, b| a.start_time.total_cmp(&b.start_time));
+    for index in 0..matches.len() {
+        let limit = matches.get(index + 1).map_or(f64::INFINITY, |next| next.start_time);
+        let end = matches[index].end_time;
+        matches[index].end_time = end.max((end + END_PADDING).min(limit));
+    }
+    SasayakiMatchData { matches, unmatched, images: source.images.clone() }
+}
+
+fn is_boundary(source: &Source, chapter: &Chapter, start: usize, index: usize) -> bool {
+    if source.sentence_ends[index] || index == chapter.end() - 1 {
+        return true;
+    }
+    source.segment_ends[index]
+        && index > start
+        && index + 2 < chapter.end()
+        && !source.sentence_ends[index + 1]
+}
+
+fn time(
+    start: usize,
+    index: usize,
+    chapter: &Chapter,
+    times: &[Option<Timing>],
+    previous: Option<&SasayakiMatch>,
+) -> Option<Span> {
+    let timed: Vec<usize> = (start..=index).filter(|&i| times[i].is_some()).collect();
+    let (Some(&first), Some(&last)) = (timed.first(), timed.last()) else {
+        return interpolate(start, index, chapter, times, previous);
+    };
+    let first_timing = times[first].unwrap();
+    let to = times[last].unwrap().end;
+    let lower = if first - start <= MAX_EDGE { start } else { first };
+    let upper = if index - last <= MAX_EDGE { index } else { last };
+    let mut from = first_timing.start;
+    if timed.len() >= 2 && times[timed[1]].unwrap().start - first_timing.end > LEADING_GAP {
+        from = times[timed[1]].unwrap().start;
+    } else {
+        from = from.max(first_timing.end - CHARACTER_SPAN);
+    }
+    from -= START_LEAD;
+
+    if !within_budget(from, to, upper - lower + 1) {
+        return interpolate(start, index, chapter, times, previous);
+    }
+    Some(Span { from, to, lower, upper })
+}
+
+fn interpolate(
+    start: usize,
+    index: usize,
+    chapter: &Chapter,
+    times: &[Option<Timing>],
+    previous: Option<&SasayakiMatch>,
+) -> Option<Span> {
+    let length = index - start + 1;
+    if length > MAX_INTERPOLATED || start <= chapter.start || index + 1 >= chapter.end() {
+        return None;
+    }
+    let previous_end = times[start - 1]?.end;
+    let next_start = times[index + 1]?.start;
+    if next_start <= previous_end || next_start - previous_end > MAX_INTERPOLATED_GAP {
+        return None;
+    }
+    let mut from = (previous_end + END_PADDING).min(next_start);
+    if let Some(previous) = previous {
+        from = from.max(previous.end_time);
+    }
+    if !within_budget(from, next_start, length) {
+        return None;
+    }
+    Some(Span { from, to: next_start, lower: start, upper: index })
+}
+
+fn within_budget(from: f64, to: f64, span: usize) -> bool {
+    to > from && (to - from) <= DURATION_OVERHEAD + MAX_SECONDS_PER_CHARACTER * span as f64
+}
