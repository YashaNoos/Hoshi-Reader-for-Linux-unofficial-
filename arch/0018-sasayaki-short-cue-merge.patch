+
+/// True when the piece after the comma at `index` is the last one of its sentence and
+/// shorter than `MIN_CUE_CHARACTERS` (…だろう、きっと。): it stays with the cue before it.
+fn short_sentence_tail(source: &Source, chapter: &Chapter, index: usize) -> bool {
+    for next in index + 1..chapter.end() {
+        if next - index > MIN_CUE_CHARACTERS - 1 {
+            return false;
+        }
+        if source.sentence_ends[next] || next == chapter.end() - 1 {
+            return true;
+        }
+        if source.segment_ends[next] {
+            return false;
+        }
+    }
+    false
 }
 
