+// 53 bits: the count goes to JavaScript and comes back as `since`, and JavaScript
+// numbers hold whole numbers exactly only up to 2^53. A 63-bit hash came back
+// rounded, never matched, and every poll looked like a new copy: the copied text
+// then replaced whatever the user had typed into the search box.
+#[cfg(target_os = "linux")]
+fn text_count(text: &str) -> i64 {
+    use std::hash::{Hash, Hasher};
+
+    let mut hasher = std::collections::hash_map::DefaultHasher::new();
+    text.hash(&mut hasher);
+    (hasher.finish() >> 11) as i64
+}
+
 #[cfg(target_os = "linux")]
 fn text() -> Option<String> {
     LAST_TEXT.lock().unwrap().take()
 }
+
+#[cfg(all(test, target_os = "linux"))]
+mod tests {
+    #[test]
+    fn counts_survive_a_round_trip_through_javascript() {
+        for text in ["食べる", "飲む", "読む", "結婚の守護女神", "a", " "] {
+            let count = super::text_count(text);
+            // A JavaScript number is an f64.
+            assert_eq!(count as f64 as i64, count, "{text:?}");
+            assert!((0..1 << 53).contains(&count), "{text:?}");
+        }
+    }
+}
