diff --git a/src/app.css b/src/app.css
index 59a347b..db61f33 100644
--- a/src/app.css
+++ b/src/app.css
@@ -186,3 +186,11 @@ html.dragging * {
     stroke-dashoffset: 100;
   }
 }
+
+/* Linux build: the selected button of a segmented control (DaisyUI .join .btn-active) is
+   only 5% darker than the others, which is barely visible on the dark theme. Lighten it
+   there instead; the light themes keep DaisyUI's style. */
+[data-theme="hoshi-dark"] .btn.btn-active {
+  --btn-bg: color-mix(in oklab, var(--color-base-200), var(--color-base-content) 16%);
+  --btn-border: color-mix(in oklab, var(--color-base-200), var(--color-base-content) 24%);
+}
