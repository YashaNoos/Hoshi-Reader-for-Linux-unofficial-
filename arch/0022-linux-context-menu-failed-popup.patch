     let gdk_window = window.gtk_window().ok()?.window()?;
     let pointer = gdk_window.display().default_seat()?.pointer()?;
@@ -17,6 +52,35 @@ fn pointer_position<R: Runtime>(window: &Window<R>) -> Option<(i32, i32)> {
     Some((x, y))
 }
 
+/// Main thread. muda's nested loop runs gtk_main_iteration(), which dispatches GLib
+/// timeouts like this one, so the check runs while that loop is stuck.
+fn cancel_menus_that_failed_to_show() {
+    glib::timeout_add_local(Duration::from_millis(100), || {
+        if POPUPS_IN_FLIGHT.load(Ordering::SeqCst) == 0 {
+            return glib::ControlFlow::Break;
+        }
+        let menus: Vec<gtk::Menu> = gtk::Window::list_toplevels()
+            .into_iter()
+            .filter_map(|toplevel| {
+                toplevel
+                    .downcast::<gtk::Window>()
+                    .ok()?
+                    .child()?
+                    .downcast()
+                    .ok()
+            })
+            .collect();
+        // Before muda has shown the menu, or after it is closed, nothing listens to
+        // "cancel"; emitting it then does nothing.
+        if !menus.iter().any(|menu| menu.get_visible()) {
+            for menu in &menus {
+                menu.cancel();
+            }
+        }
+        glib::ControlFlow::Continue
+    });
+}
