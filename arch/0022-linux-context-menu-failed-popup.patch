 // ("Couldn't map as window ... as popup because it doesn't have a parent") and
 // places it at the wrong spot. Read the pointer position relative to our own
 // window instead and anchor the menu there; this also works on X11.
+//
+// muda shows the menu from inside Tauri's event loop and then runs a nested GTK
+// loop until the menu sends "cancel" or "selection-done". GTK can end up with the
+// menu hidden without sending either, and the nested loop never ends:
+// - Wayland (KWin): the compositor closes the popup, e.g. on a click on the title
+//   bar or when KWin opens its own window menu; GTK hides the menu silently.
+// - X11: the popup gives up when it cannot grab the pointer and keyboard because
+//   another client holds a grab at that moment (a global shortcut, another app's
+//   menu, a screenshot tool).
+// Tauri's event loop is then blocked for good: the close button and Alt+F4 do
+// nothing and no further menu opens, while the page still draws and scrolls.
+// GTK's own rule is that a menu is on screen if gtk_widget_get_visible() says so,
+// so while a popup is in flight, check that a menu is visible and cancel the menus
+// when none is: muda takes the "cancel" as a dismissed menu and returns.
 
+use std::sync::atomic::{AtomicUsize, Ordering};
 use std::sync::mpsc;
+use std::time::Duration;
 
+use gtk::glib;
 use gtk::prelude::*;
 use tauri::menu::{ContextMenu, Menu};
 use tauri::{LogicalPosition, Manager, ResourceId, Runtime, Webview, Window};
 
+/// Popups asked for whose `popup`/`popup_at` has not returned yet.
+static POPUPS_IN_FLIGHT: AtomicUsize = AtomicUsize::new(0);
+
+struct InFlight;
+
+impl InFlight {
+    fn start() -> Self {
+        POPUPS_IN_FLIGHT.fetch_add(1, Ordering::SeqCst);
+        InFlight
+    }
+}
+
+impl Drop for InFlight {
+    fn drop(&mut self) {
+        POPUPS_IN_FLIGHT.fetch_sub(1, Ordering::SeqCst);
+    }
+}
