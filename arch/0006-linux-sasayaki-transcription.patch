diff --git a/src-tauri/src/transcriber/linux.rs b/src-tauri/src/transcriber/linux.rs
new file mode 100644
index 0000000..e07a971
--- /dev/null
+++ b/src-tauri/src/transcriber/linux.rs
@@ -0,0 +1,113 @@
+//! Linux transcription backend: sherpa-onnx with the ReazonSpeech model (see
+//! `crate::transcription`). The model (~160 MB) is downloaded on first use into the app's
+//! cache directory and checked with SHA-256; after that everything runs offline.
+//!
+//! Built without the `transcription` feature, transcription reports "unsupported".
+
+use tauri::AppHandle;
+use tokio_util::sync::CancellationToken;
+
+use super::Events;
+use crate::sasayaki::SasayakiToken;
+
+pub struct Audio {
+    #[cfg_attr(not(feature = "transcription"), allow(dead_code))]
+    path: std::path::PathBuf,
+    pub duration: f64,
+    /// Already saved tokens near the resume point, to drop repeated words.
+    #[cfg_attr(not(feature = "transcription"), allow(dead_code))]
+    previous: Vec<SasayakiToken>,
+}
+
+impl Audio {
+    pub fn resuming_after(mut self, tokens: &[SasayakiToken], through: f64) -> Self {
+        let tail = tokens.partition_point(|token| token.end < through - 1.0);
+        self.previous = tokens[tail..].to_vec();
+        self
+    }
+}
+
+#[cfg(feature = "transcription")]
+pub fn prepare(path: &str) -> Result<Audio, String> {
+    let path = std::path::PathBuf::from(path);
+    let duration = crate::transcription::audio::duration(&path)
+        .ok_or_else(|| format!("Could not read {}", path.display()))?;
+    Ok(Audio {
+        path,
+        duration,
+        previous: Vec::new(),
+    })
+}
+
+#[cfg(feature = "transcription")]
+pub fn start(
+    app: &AppHandle,
+    audio: Audio,
+    from: f64,
+    _performance: i32,
+    events: Events,
+    cancel: CancellationToken,
+) -> Result<(), String> {
+    use std::sync::Arc;
+    use std::sync::atomic::{AtomicBool, Ordering};
+    use tauri::Manager;
+
+    use super::Event;
+
+    let model_dir = app
+        .path()
+        .app_cache_dir()
+        .unwrap_or_else(|_| std::env::temp_dir())
+        .join("Models")
+        .join("reazonspeech-k2-v2-int8");
+    let stop = Arc::new(AtomicBool::new(false));
+    let flag = stop.clone();
+    tauri::async_runtime::spawn(async move {
+        cancel.cancelled().await;
+        flag.store(true, Ordering::Relaxed);
+    });
+    std::thread::spawn(move || {
+        let result = crate::transcription::transcribe(
+            &model_dir,
+            &audio.path,
+            from,
+            &audio.previous,
+            &stop,
+            &mut |fraction| {
+                events.send(Event::Download(fraction)).ok();
+            },
+            &mut |tokens, through| {
+                events.send(Event::Tokens(tokens, through)).ok();
+            },
+        );
+        events.send(Event::Finish(result.err())).ok();
+    });
+    Ok(())
+}
+
+#[cfg(feature = "transcription")]
+pub async fn status(_app: AppHandle) -> &'static str {
+    "available"
+}
+
+#[cfg(not(feature = "transcription"))]
+pub fn prepare(_path: &str) -> Result<Audio, String> {
+    Err("This build has no transcription support".into())
+}
+
+#[cfg(not(feature = "transcription"))]
+pub fn start(
+    _app: &AppHandle,
+    _audio: Audio,
+    _from: f64,
+    _performance: i32,
+    _events: Events,
+    _cancel: CancellationToken,
+) -> Result<(), String> {
+    Err("This build has no transcription support".into())
+}
+
+#[cfg(not(feature = "transcription"))]
+pub async fn status(_app: AppHandle) -> &'static str {
+    "unsupported"
+}
diff --git a/src-tauri/src/transcription/audio.rs b/src-tauri/src/transcription/audio.rs
new file mode 100644
index 0000000..fa0e09d
--- /dev/null
+++ b/src-tauri/src/transcription/audio.rs
@@ -0,0 +1,144 @@
+// Streaming audiobook decode to 16 kHz mono for speech recognition.
+
+use std::fs::File;
+use std::path::Path;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use sherpa_onnx::LinearResampler;
+use symphonia::core::audio::SampleBuffer;
+use symphonia::core::codecs::{CODEC_TYPE_NULL, DecoderOptions};
+use symphonia::core::errors::Error;
+use symphonia::core::formats::{FormatOptions, FormatReader, SeekMode, SeekTo, Track};
+use symphonia::core::io::MediaSourceStream;
+use symphonia::core::meta::MetadataOptions;
+use symphonia::core::probe::Hint;
+use symphonia::core::units::Time;
+
+use super::pipeline::SAMPLE_RATE;
+
+fn open(path: &Path) -> Result<Box<dyn FormatReader>, String> {
+    let file = File::open(path).map_err(|e| format!("Could not open {}: {e}", path.display()))?;
+    let stream = MediaSourceStream::new(Box::new(file), Default::default());
+    let mut hint = Hint::new();
+    if let Some(ext) = path.extension().and_then(|e| e.to_str()) {
+        hint.with_extension(ext);
+    }
+    symphonia::default::get_probe()
+        .format(&hint, stream, &FormatOptions::default(), &MetadataOptions::default())
+        .map(|probed| probed.format)
+        .map_err(|e| format!("Unsupported audio file: {e}"))
+}
+
+fn audio_track(format: &dyn FormatReader) -> Result<Track, String> {
+    format
+        .tracks()
+        .iter()
+        .find(|t| t.codec_params.codec != CODEC_TYPE_NULL)
+        .cloned()
+        .ok_or_else(|| "No audio track".to_string())
+}
+
+/// Duration in seconds, from the container when it knows it, else by scanning packets.
+pub fn duration(path: &Path) -> Option<f64> {
+    let mut format = open(path).ok()?;
+    let track = audio_track(format.as_ref()).ok()?;
+    let rate = track.codec_params.sample_rate? as f64;
+    if let Some(frames) = track.codec_params.n_frames {
+        return Some(frames as f64 / rate);
+    }
+    let base = track.codec_params.time_base?;
+    let mut end = 0u64;
+    while let Ok(packet) = format.next_packet() {
+        if packet.track_id() == track.id {
+            end = end.max(packet.ts() + packet.dur());
+        }
+    }
+    let time = base.calc_time(end);
+    Some(time.seconds as f64 + time.frac)
+}
+
+/// Decodes from `from` seconds, calling `sink` with 16 kHz mono chunks.
+/// Stops early (Ok) when `cancel` is set.
+pub fn decode(path: &Path, from: f64, cancel: &AtomicBool, mut sink: impl FnMut(&[f32])) -> Result<(), String> {
+    let mut format = open(path)?;
+    let track = audio_track(format.as_ref())?;
+    let rate = track.codec_params.sample_rate.ok_or("Unknown sample rate")?;
+    let mut decoder = symphonia::default::get_codecs()
+        .make(&track.codec_params, &DecoderOptions::default())
+        .map_err(|e| format!("Unsupported audio codec: {e}"))?;
+
+    // Position (in source frames) of the next decoded frame; frames before `skip_to` are dropped.
+    let skip_to = (from * rate as f64).round() as u64;
+    let mut position = 0u64;
+    if from > 0.0 {
+        if let Ok(seeked) = format.seek(SeekMode::Accurate, SeekTo::Time { time: Time::from(from), track_id: Some(track.id) }) {
+            decoder.reset();
+            position = track
+                .codec_params
+                .time_base
+                .map(|base| {
+                    let t = base.calc_time(seeked.actual_ts);
+                    ((t.seconds as f64 + t.frac) * rate as f64).round() as u64
+                })
+                .unwrap_or(0);
+        }
+    }
+
+    let resampler = if rate as i64 != SAMPLE_RATE {
+        Some(LinearResampler::create(rate as i32, SAMPLE_RATE as i32).ok_or("Could not create resampler")?)
+    } else {
+        None
+    };
+    let mut mono = Vec::new();
+    loop {
+        if cancel.load(Ordering::Relaxed) {
+            return Ok(());
+        }
+        let packet = match format.next_packet() {
+            Ok(packet) => packet,
+            Err(Error::IoError(e)) if e.kind() == std::io::ErrorKind::UnexpectedEof => break,
+            Err(Error::ResetRequired) => break,
+            Err(e) => return Err(format!("Audio read error: {e}")),
+        };
+        if packet.track_id() != track.id {
+            continue;
+        }
+        let decoded = match decoder.decode(&packet) {
+            Ok(decoded) => decoded,
+            Err(Error::DecodeError(_)) => continue,
+            Err(e) => return Err(format!("Audio decode error: {e}")),
+        };
+        let spec = *decoded.spec();
+        let channels = spec.channels.count().max(1);
+        let mut buffer = SampleBuffer::<f32>::new(decoded.capacity() as u64, spec);
+        buffer.copy_interleaved_ref(decoded);
+        let frames = buffer.samples().len() / channels;
+        let skip = skip_to.saturating_sub(position).min(frames as u64) as usize;
+        position += frames as u64;
+        mono.clear();
+        mono.extend(
+            buffer.samples()[skip * channels..]
+                .chunks_exact(channels)
+                .map(|frame| frame.iter().sum::<f32>() / channels as f32),
+        );
+        if mono.is_empty() {
+            continue;
+        }
+        match &resampler {
+            Some(r) => {
+                let out = r.resample(&mono, false);
+                if !out.is_empty() {
+                    sink(&out);
+                }
+            }
+            None => sink(&mono),
+        }
+    }
+    if let Some(r) = &resampler {
+        let out = r.resample(&[], true);
+        if !out.is_empty() {
+            sink(&out);
+        }
+    }
+    Ok(())
+}
diff --git a/src-tauri/src/transcription/mod.rs b/src-tauri/src/transcription/mod.rs
new file mode 100644
index 0000000..be07601
--- /dev/null
+++ b/src-tauri/src/transcription/mod.rs
@@ -0,0 +1,130 @@
+// On-device Sasayaki transcription for Linux: sherpa-onnx + ReazonSpeech k2 v2,
+// following the pipeline of Hoshi Reader Android. Used by transcriber/linux.rs; the
+// transcript is aligned to the book by the shared aligner (aligner.rs).
+
+pub mod audio;
+pub mod model;
+mod pipeline;
+
+use std::path::Path;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex, mpsc};
+
+use sherpa_onnx::{OfflineModelConfig, OfflineRecognizer, OfflineRecognizerConfig, OfflineTransducerModelConfig};
+
+pub use crate::sasayaki::SasayakiToken as Token;
+use pipeline::{Batch, OrderedScheduler, Pipeline, Recognition, Stitcher, project_tokens};
+
+/// Concurrent recognitions and ONNX threads per recognition, from the CPU count.
+fn parallelism() -> (usize, i32) {
+    let cores = std::thread::available_parallelism().map_or(2, |n| n.get());
+    let workers = (cores / 2).clamp(1, 4);
+    let threads = (cores / workers).clamp(1, 4) as i32;
+    (workers, threads)
+}
+
+fn recognizer(paths: &model::ModelPaths, threads: i32) -> Result<OfflineRecognizer, String> {
+    let path = |p: &Path| Some(p.to_string_lossy().into_owned());
+    let mut config = OfflineRecognizerConfig::default();
+    config.model_config = OfflineModelConfig {
+        transducer: OfflineTransducerModelConfig {
+            encoder: path(&paths.encoder),
+            decoder: path(&paths.decoder),
+            joiner: path(&paths.joiner),
+        },
+        tokens: path(&paths.tokens),
+        num_threads: threads,
+        provider: Some("cpu".into()),
+        model_type: Some("transducer".into()),
+        ..Default::default()
+    };
+    config.decoding_method = Some("greedy_search".into());
+    OfflineRecognizer::create(&config).ok_or_else(|| "Could not load the speech recognition model".to_string())
+}
+
+fn recognize(recognizer: &OfflineRecognizer, job: &Recognition) -> Result<Batch, String> {
+    let stream = recognizer.create_stream();
+    stream.accept_waveform(pipeline::SAMPLE_RATE as i32, &job.samples);
+    recognizer.decode(&stream);
+    let result = stream.get_result().ok_or("Speech recognition failed")?;
+    let timestamps = result.timestamps.unwrap_or_default();
+    if timestamps.len() != result.tokens.len() {
+        return Err("Speech recognition returned no token timestamps".into());
+    }
+    Ok(Batch {
+        tokens: project_tokens(&result.tokens, &timestamps, job.segment_start, job.segment_end),
+        through: job.through,
+        segment_start: job.segment_start,
+    })
+}
+
+/// Transcribes `path` from `from` seconds. Blocking; returns Ok(()) when cancelled.
+/// `previous` is the already saved transcript tail, used to drop repeated words on resume.
+pub fn transcribe(
+    model_dir: &Path,
+    path: &Path,
+    from: f64,
+    previous: &[Token],
+    cancel: &AtomicBool,
+    on_download: &mut dyn FnMut(f64),
+    on_tokens: &mut dyn FnMut(Vec<Token>, f64),
+) -> Result<(), String> {
+    let duration = audio::duration(path).ok_or_else(|| format!("Could not read {}", path.display()))?;
+    if from >= duration {
+        on_tokens(Vec::new(), duration);
+        return Ok(());
+    }
+    let Some(paths) = tauri::async_runtime::block_on(model::ensure(model_dir, cancel, on_download))? else {
+        return Ok(());
+    };
+    let (workers, threads) = parallelism();
+    let recognizer = Arc::new(recognizer(&paths, threads)?);
+
+    type Work = (Recognition, mpsc::SyncSender<Result<Batch, String>>);
+    let (jobs, queue) = mpsc::channel::<Work>();
+    let queue = Arc::new(Mutex::new(queue));
+    let handles: Vec<_> = (0..workers)
+        .map(|_| {
+            let (queue, recognizer) = (queue.clone(), recognizer.clone());
+            std::thread::spawn(move || loop {
+                let next = queue.lock().unwrap().recv();
+                let Ok((job, reply)) = next else { break };
+                reply.send(recognize(&recognizer, &job)).ok();
+            })
+        })
+        .collect();
+
+    // Half a second of leading context; the stitcher drops what was already saved.
+    let audio_from = (from - 0.5).max(0.0);
+    let mut pipeline = Pipeline::new(from, duration, audio_from);
+    let mut scheduler = OrderedScheduler::new(jobs, workers + 1, Stitcher::new(from, previous), from, on_tokens);
+    let stop = AtomicBool::new(false);
+    let decoded = audio::decode(path, audio_from, &stop, |chunk| {
+        pipeline.accept(chunk, &mut |job| scheduler.schedule(job));
+        if cancel.load(Ordering::Relaxed) || scheduler.error().is_some() {
+            stop.store(true, Ordering::Relaxed);
+        }
+    });
+    // The scheduler owns the job queue's sender: it must be finished or dropped on
+    // every path before joining, so idle workers see the queue close and exit.
+    let result = if cancel.load(Ordering::Relaxed) {
+        drop(scheduler);
+        Ok(())
+    } else {
+        let decoded = decoded.and_then(|_| match scheduler.error() {
+            Some(error) => Err(error.clone()),
+            None => pipeline.finish(&mut |job| scheduler.schedule(job)),
+        });
+        match decoded {
+            Ok(()) => scheduler.finish(),
+            Err(error) => {
+                drop(scheduler);
+                Err(error)
+            }
+        }
+    };
+    for handle in handles {
+        handle.join().ok();
+    }
+    result
+}
diff --git a/src-tauri/src/transcription/model.rs b/src-tauri/src/transcription/model.rs
new file mode 100644
index 0000000..747a2b8
--- /dev/null
+++ b/src-tauri/src/transcription/model.rs
@@ -0,0 +1,140 @@
+// ReazonSpeech k2 v2 (Apache-2.0) model files: the same pinned revision and checksums
+// as Hoshi Reader Android, downloaded on first use and verified with SHA-256.
+
+use std::fs;
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use sha2::{Digest, Sha256};
+
+const BASE: &str = "https://huggingface.co/reazon-research/reazonspeech-k2-v2/resolve/291488c8151be24d7da4bf7af26e533fad96e407/";
+
+pub struct ModelFile {
+    pub name: &'static str,
+    remote: &'static str,
+    bytes: u64,
+    sha256: &'static str,
+}
+
+pub const FILES: [ModelFile; 4] = [
+    ModelFile { name: "encoder.int8.onnx", remote: "encoder-epoch-99-avg-1.int8.onnx", bytes: 154_670_139,
+        sha256: "2c7bd08a8a99f9ddd0d9e458456577b1f6279214e51426f114f9eced44c54e1d" },
+    ModelFile { name: "decoder.int8.onnx", remote: "decoder-epoch-99-avg-1.int8.onnx", bytes: 2_959_337,
+        sha256: "8f0bff94d38797b03b762634ed03211a8e303d06cc4603cdd0cf4199d6eb1485" },
+    ModelFile { name: "joiner.int8.onnx", remote: "joiner-epoch-99-avg-1.int8.onnx", bytes: 2_696_970,
+        sha256: "49cc7ea1d3d35a40a27442db5e89996da64bf0e683a903dce76e99e57a12e4de" },
+    ModelFile { name: "tokens.txt", remote: "tokens.txt", bytes: 45_754,
+        sha256: "2c3ac659818a48a0c04010e0593bbc4d7c8a24a054340b01131499c05fd52def" },
+];
+
+const VERIFIED_MARKER: &str = ".verified";
+
+pub struct ModelPaths {
+    pub encoder: PathBuf,
+    pub decoder: PathBuf,
+    pub joiner: PathBuf,
+    pub tokens: PathBuf,
+}
+
+impl ModelPaths {
+    fn in_dir(dir: &Path) -> Self {
+        let find = |file: &ModelFile| {
+            let local = dir.join(file.name);
+            if local.is_file() { local } else { dir.join(file.remote) }
+        };
+        ModelPaths { encoder: find(&FILES[0]), decoder: find(&FILES[1]), joiner: find(&FILES[2]), tokens: find(&FILES[3]) }
+    }
+}
+
+fn hex(digest: &[u8]) -> String {
+    digest.iter().map(|byte| format!("{byte:02x}")).collect()
+}
+
+fn sha256(path: &Path) -> std::io::Result<String> {
+    use std::io::Read;
+    let mut hasher = Sha256::new();
+    let mut file = fs::File::open(path)?;
+    let mut buffer = vec![0u8; 1 << 20];
+    loop {
+        let read = file.read(&mut buffer)?;
+        if read == 0 {
+            break;
+        }
+        hasher.update(&buffer[..read]);
+    }
+    Ok(hex(&hasher.finalize()))
+}
+
+/// Returns ready model paths, downloading (with `progress` in 0..=1) when needed.
+/// `HOSHI_SASAYAKI_MODEL_DIR` points at a directory with the files already present.
+pub async fn ensure(dir: &Path, cancel: &AtomicBool, progress: &mut dyn FnMut(f64)) -> Result<Option<ModelPaths>, String> {
+    if let Some(custom) = std::env::var_os("HOSHI_SASAYAKI_MODEL_DIR") {
+        return Ok(Some(ModelPaths::in_dir(Path::new(&custom))));
+    }
+    fetch(BASE, dir, cancel, progress).await
+}
+
+pub(crate) async fn fetch(
+    base: &str,
+    dir: &Path,
+    cancel: &AtomicBool,
+    progress: &mut dyn FnMut(f64),
+) -> Result<Option<ModelPaths>, String> {
+    let present = |file: &ModelFile| fs::metadata(dir.join(file.name)).is_ok_and(|m| m.len() == file.bytes);
+    if dir.join(VERIFIED_MARKER).is_file() && FILES.iter().all(present) {
+        return Ok(Some(ModelPaths::in_dir(dir)));
+    }
+    fs::create_dir_all(dir).map_err(|e| format!("Cannot create model directory: {e}"))?;
+    fs::remove_file(dir.join(VERIFIED_MARKER)).ok();
+
+    let total: u64 = FILES.iter().map(|f| f.bytes).sum();
+    let mut done: u64 = FILES.iter().filter(|f| present(f)).map(|f| f.bytes).sum();
+    progress(done as f64 / total as f64);
+    let client = reqwest::Client::new();
+    for file in &FILES {
+        let target = dir.join(file.name);
+        if present(file) && sha256(&target).is_ok_and(|h| h == file.sha256) {
+            continue;
+        }
+        if present(file) {
+            done -= file.bytes;
+        }
+        let partial = dir.join(format!("{}.part", file.name));
+        let mut response = client
+            .get(format!("{base}{}", file.remote))
+            .send()
+            .await
+            .and_then(|r| r.error_for_status())
+            .map_err(|e| format!("Model download failed: {e}"))?;
+        let mut out = fs::File::create(&partial).map_err(|e| format!("Cannot write model: {e}"))?;
+        let mut hasher = Sha256::new();
+        let mut received = 0u64;
+        while let Some(chunk) = response.chunk().await.map_err(|e| format!("Model download failed: {e}"))? {
+            if cancel.load(Ordering::Relaxed) {
+                drop(out);
+                fs::remove_file(&partial).ok();
+                return Ok(None);
+            }
+            received += chunk.len() as u64;
+            if received > file.bytes {
+                fs::remove_file(&partial).ok();
+                return Err("Model download is larger than expected".into());
+            }
+            hasher.update(&chunk);
+            out.write_all(&chunk).map_err(|e| format!("Cannot write model: {e}"))?;
+            progress((done + received) as f64 / total as f64);
+        }
+        out.flush().ok();
+        drop(out);
+        if received != file.bytes || hex(&hasher.finalize()) != file.sha256 {
+            fs::remove_file(&partial).ok();
+            return Err("Model integrity verification failed".into());
+        }
+        fs::rename(&partial, &target).map_err(|e| format!("Cannot save model: {e}"))?;
+        done += file.bytes;
+    }
+    fs::write(dir.join(VERIFIED_MARKER), b"").ok();
+    progress(1.0);
+    Ok(Some(ModelPaths::in_dir(dir)))
+}
