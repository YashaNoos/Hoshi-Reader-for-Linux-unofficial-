        '0006-linux-sasayaki-transcription.patch'
        '0007-linux-wayland-context-menu.patch'
        '0008-linux-attribution-and-updater.patch'
        '0009-linux-clipboard-monitor-reselect.patch'
        '0010-linux-clipboard-read-off-main-thread.patch'
        '0011-linux-appimage-theme.patch'
        '0012-linux-webkitgtk-2.54-popup-subresources.patch'
        '0013-linux-system-theme.patch'
        '0014-linux-anki-cover-as-data.patch'
        '0015-linux-lookup-highlight-size.patch'
        '0016-linux-lookup-highlight-offset.patch'
        '0017-linux-dark-theme-selected-buttons.patch'
        '0018-sasayaki-merge-short-cues.patch'
        '0019-sasayaki-parakeet-ja.patch'
        '0020-sasayaki-aligner-unlikely-matches.patch'
