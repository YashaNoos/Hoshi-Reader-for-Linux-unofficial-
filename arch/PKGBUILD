        "https://github.com/k2-fsa/sherpa-onnx/releases/download/v1.13.8/sherpa-onnx-v1.13.8-linux-x64-static-lib.tar.bz2")
noextract=('sherpa-onnx-v1.13.8-linux-x64-static-lib.tar.bz2')
